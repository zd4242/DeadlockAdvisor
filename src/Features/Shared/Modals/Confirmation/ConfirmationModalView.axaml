<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:confirmation="clr-namespace:DeadlockAdvisor.Features.Shared.Modals.Confirmation"
             x:DataType="confirmation:ConfirmationModalViewModel"
             x:Class="DeadlockAdvisor.Features.Shared.Modals.Confirmation.ConfirmationModalView">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">
            <Button Content="{Binding ConfirmText}"
                    Name="{x:Static confirmation:ConfirmationModalView.ConfirmButtonName}"
                    Classes.danger="{Binding IsDestructive}"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ConfirmCommand}"
                    MinWidth="80"
                    Padding="10,6"/>
            <Button Content="{Binding SecondaryConfirmText}"
                    HorizontalContentAlignment="Center"
                    Command="{Binding SecondaryConfirmCommand}"
                    IsVisible="{Binding SecondaryConfirmCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                    MinWidth="80"
                    Padding="10,6"/>
            <Button Content="{Binding CancelText}"
                    Name="{x:Static confirmation:ConfirmationModalView.CancelButtonName}"
                    HorizontalContentAlignment="Center"
                    Command="{Binding CancelCommand}"
                    MinWidth="80"
                    Padding="10,6"/>
        </StackPanel>
    </StackPanel>
</UserControl>
