<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:DeadlockAdvisor.Features.Shared.Modals.Base"
             x:Class="DeadlockAdvisor.Features.Shared.Modals.Base.Modal"
             x:DataType="base:ModalViewModel">

    <UserControl.Styles>
        <Style Selector="Panel.overlay">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Panel.overlay.visible">
            <Setter Property="IsVisible" Value="True"/>
            <Style.Animations>
                <Animation Duration="0:0:0.25" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.modal">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
            <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
        </Style>
        <Style Selector="Border.modal.visible">
            <Setter Property="IsVisible" Value="True"/>
            <Style.Animations>
                <Animation Duration="0:0:0.25" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%" KeySpline="0.2,0.0,0.0,1.0">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Panel Name="OverlayPanel"
               Classes="overlay"
               Classes.visible="{Binding IsVisible}"
               Background="Black" />

        <Border Name="ModalBorder"
                Classes="modal"
                Classes.visible="{Binding IsVisible}"
                Background="{DynamicResource ModalBackground}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 4 8 0 #40000000"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MinWidth="400"
                MaxWidth="800"
                MaxHeight="600">
            <Border.RenderTransform>
                <ScaleTransform/>
            </Border.RenderTransform>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding Content}"/>
            </ScrollViewer>
        </Border>
    </Panel>
</UserControl>
