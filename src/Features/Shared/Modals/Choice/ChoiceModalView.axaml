<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:choice="using:DeadlockAdvisor.Features.Shared.Modals.Choice"
             x:Class="DeadlockAdvisor.Features.Shared.Modals.Choice.ChoiceModalView"
             x:DataType="choice:ChoiceModalViewModel">
    <StackPanel Margin="20" Spacing="12" MinWidth="360">
        <TextBlock Classes="h2" Text="{Binding Title}"/>
        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"/>
        <ComboBox x:Name="Choices"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Choices}"
                  SelectedIndex="{Binding SelectedIndex}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
            <Button Classes="primary"
                    Content="OK"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    Command="{Binding OkCommand}"/>
            <Button Content="Cancel"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
