<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:DeadlockAdvisor.Features.Shared"
             x:Class="DeadlockAdvisor.Features.Shared.PlaceholderPageView"
             x:DataType="shared:PlaceholderPageViewModel">
    <Border Classes="card" Margin="12">
        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <TextBlock Classes="h2" Text="{Binding Title}" HorizontalAlignment="Center"/>
            <TextBlock Classes="dim" Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
