<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notifications="clr-namespace:DeadlockAdvisor.Features.Shared.Notifications"
             x:Class="DeadlockAdvisor.Features.Shared.Notifications.NotificationOverlay"
             x:DataType="notifications:NotificationOverlayViewModel">

    <UserControl.Styles>
        <Style Selector="Border.notification">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinWidth" Value="300"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #40000000"/>
        </Style>

        <Style Selector="Border.notification[Tag=Info]">
            <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
        </Style>
        <Style Selector="PathIcon.notificationIcon[Tag=Info]">
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
        </Style>

        <Style Selector="Border.notification[Tag=Success]">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        </Style>
        <Style Selector="PathIcon.notificationIcon[Tag=Success]">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        </Style>

        <Style Selector="Border.notification[Tag=Warning]">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="PathIcon.notificationIcon[Tag=Warning]">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
        </Style>

        <Style Selector="Border.notification[Tag=Error]">
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
        </Style>
        <Style Selector="PathIcon.notificationIcon[Tag=Error]">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        </Style>

        <Style Selector="Border.notification">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="TranslateTransform.X" Value="100"/>
            <Style.Animations>
                <Animation Duration="0:0:0.25" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.X" Value="100"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%" KeySpline="0.2,0.0,0.0,1.0">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <ItemsControl ItemsSource="{Binding Notifications}"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Right"
                  Margin="20">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Classes="notification"
                        Tag="{Binding Severity}">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>

                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Classes="notificationIcon"
                                  Tag="{Binding Severity}"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,12,0"
                                  Data="{Binding Severity, Converter={StaticResource SeverityToIconConverter}}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
