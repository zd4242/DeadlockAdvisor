<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:detect="using:DeadlockAdvisor.Features.Match.Detect"
             xmlns:controls="using:DeadlockAdvisor.Controls"
             xmlns:art="using:DeadlockAdvisor.Controls.Art"
             x:Class="DeadlockAdvisor.Features.Match.Detect.DetectReviewView"
             x:DataType="detect:DetectReviewViewModel">

    <UserControl.Styles>
        <Style Selector="Border.slot">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="Border.slot.you">
            <Setter Property="BorderBrush" Value="{DynamicResource SelfBrush}"/>
        </Style>
        <Style Selector="ToggleButton.portrait">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.portrait:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ToggleButton.portrait:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SelfBrush}"/>
        </Style>
        <Style Selector=".picking ToggleButton.portrait:not(:checked) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SelfBrush}"/>
        </Style>
        <Style Selector="TextBlock.role">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>
        <Style Selector="TextBlock.role.you">
            <Setter Property="Foreground" Value="{DynamicResource SelfBrush}"/>
        </Style>
        <Style Selector="TextBlock.detail.uncertain">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="TextBlock.detail.corrected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="detect:SlotReviewViewModel">
            <Border Classes="slot" Classes.you="{Binding IsYou}">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- The portrait is the big target for picking yourself, as well as the button beside the name. -->
                    <ToggleButton Classes="portrait"
                                  IsChecked="{Binding IsYou, Mode=OneWay}"
                                  Command="{Binding SetSelfCommand}"
                                  ToolTip.Tip="This slot is you: the teams follow from it">
                        <Border Width="44" Height="73" CornerRadius="4" ClipToBounds="True"
                                Background="{DynamicResource BgBrush}">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        </Border>
                    </ToggleButton>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Classes="role"
                                       Classes.you="{Binding IsYou}"
                                       Text="{Binding RoleText}"/>
                            <TextBlock Grid.Column="1"
                                       Classes="role"
                                       Margin="0,0,8,0"
                                       Text="{Binding NetWorth}"
                                       ToolTip.Tip="Net worth, as read under the portrait"/>
                            <ToggleButton Grid.Column="2"
                                          Classes="pill self"
                                          Content="This is me"
                                          FontSize="13"
                                          Padding="12,4"
                                          MinHeight="28"
                                          IsChecked="{Binding IsYou, Mode=OneWay}"
                                          Command="{Binding SetSelfCommand}"
                                          ToolTip.Tip="This slot is you: the teams follow from it"/>
                        </Grid>
                        <!-- A portrait beside each choice, to set against the crop on the left. "Not
                             detected" has none but keeps the gap, so the names stay in line. -->
                        <controls:SearchComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding SelectedHero}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="detect:HeroChoice">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <art:ArtImage Width="20"
                                                      Height="20"
                                                      Kind="Hero"
                                                      ArtId="{Binding HeroId}"
                                                      ArtName="{Binding Name}"
                                                      VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </controls:SearchComboBox>
                        <TextBlock Classes="hint detail"
                                   Classes.uncertain="{Binding IsUncertain}"
                                   Classes.corrected="{Binding WasCorrected}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Detail}"
                                   ToolTip.Tip="{Binding DetailTip}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <StackPanel Margin="20" Spacing="12" Width="700" Classes.picking="{Binding !HasSelf}">
        <TextBlock Classes="h2" Text="Detected match"/>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"/>

        <Grid ColumnDefinitions="*,14,*">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Classes.ally="{Binding HasSelf}" Text="{Binding OwnHeading}"/>
                <ItemsControl x:Name="OwnRows" ItemsSource="{Binding OwnRows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="section" Classes.enemy="{Binding HasSelf}" Text="{Binding FoeHeading}"/>
                <ItemsControl x:Name="FoeRows" ItemsSource="{Binding FoeRows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
            <!-- Until you're picked, this spot says that's what Apply waits on. After that it offers to remember
                 corrections, once there are any; that's also under Settings → Detection. Beside the buttons rather
                 than above them, so neither grows the dialog. -->
            <Border Classes="blocker" Margin="0,0,16,0" IsVisible="{Binding !HasSelf}">
                <StackPanel>
                    <PathIcon/>
                    <TextBlock Text="Pick your own slot to apply"/>
                </StackPanel>
            </Border>
            <CheckBox Content="Remember my corrections as reference art"
                      VerticalAlignment="Center"
                      IsChecked="{Binding RememberCorrections}"
                      ToolTip.Tip="Saves each corrected crop into assets/topbar/&lt;hero&gt;/ so the same portrait is recognised next time">
                <CheckBox.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasCorrections"/>
                        <Binding Path="HasSelf"/>
                    </MultiBinding>
                </CheckBox.IsVisible>
            </CheckBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="ApplyButton"
                        Classes="primary"
                        Content="Apply to match"
                        MinWidth="80"
                        HorizontalContentAlignment="Center"
                        IsDefault="True"
                        Command="{Binding ApplyCommand}"/>
                <Button Content="Cancel"
                        MinWidth="80"
                        HorizontalContentAlignment="Center"
                        IsCancel="True"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
