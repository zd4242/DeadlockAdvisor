<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:match="using:DeadlockAdvisor.Features.Match"
             xmlns:board="using:DeadlockAdvisor.Features.Match.Board"
             xmlns:results="using:DeadlockAdvisor.Features.Match.Results"
             xmlns:explain="using:DeadlockAdvisor.Features.Match.Explain"
             xmlns:controls="using:DeadlockAdvisor.Controls"
             xmlns:theme="using:DeadlockAdvisor.Theme"
             x:Class="DeadlockAdvisor.Features.Match.MatchView"
             x:DataType="match:MatchViewModel">

    <UserControl.Styles>
        <Style Selector="Button.glyph.active > Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.glyph.open > Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- Who the list leans toward, in the enemy's colour, as the match bar marks them. -->
        <Style Selector="Border.focus">
            <Setter Property="Background">
                <SolidColorBrush Color="{x:Static theme:Palette.Enemy}" Opacity="0.15"/>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource EnemyBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="7,0,0,0"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="Border.focus Button.icon">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="5,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,12,*" Margin="12">
        <board:RosterView DataContext="{Binding Board}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Classes="card">
                <DockPanel>
                    <!-- What ranks the list stays in view; the rest sits behind Filters. -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                        <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Spacing="3">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="section" VerticalAlignment="Center" Text="RECOMMENDED ITEMS"/>
                                <!-- The enemies clicked on the match bar, and a way to stop focusing on them. -->
                                <Border Grid.Column="1"
                                        Classes="focus"
                                        Margin="10,-3,8,-3"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding Board.HasFocus}"
                                        ToolTip.Tip="{Binding Board.FocusTip}">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center"
                                              Stretch="None"
                                              Stroke="{DynamicResource EnemyBrush}"
                                              StrokeThickness="1.3"
                                              StrokeLineCap="Round"
                                              Data="M6,2.5 A3.5,3.5 0 1 1 6,9.5 A3.5,3.5 0 1 1 6,2.5 Z M6,0.5 V4 M6,8 V11.5 M0.5,6 H4 M8,6 H11.5"/>
                                        <Button DockPanel.Dock="Right"
                                                Classes="icon"
                                                Content="×"
                                                Command="{Binding Board.ClearFocusCommand}"
                                                ToolTip.Tip="Stop focusing: every enemy counts the same again"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Board.FocusLabel}"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <TextBlock Classes="faint"
                                       TextTrimming="CharacterEllipsis"
                                       Background="Transparent"
                                       Text="{Binding Results.Summary}"
                                       ToolTip.Tip="{Binding Results.SummaryTip}"
                                       IsVisible="{Binding !Results.IsEmpty}"/>
                        </StackPanel>
                        <!-- The caption sits over the box rather than beside it, so it costs no width. -->
                        <TextBlock Grid.Column="1"
                                   Classes="faint"
                                   FontSize="11"
                                   Margin="2,0,0,1"
                                   Text="Items ranked by"/>
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  VerticalAlignment="Stretch"
                                  ItemsSource="{Binding Ranks}"
                                  SelectedItem="{Binding SelectedRank}"
                                  IsEnabled="{Binding HasMatchData}"
                                  ToolTip.ShowOnDisabled="True"
                                  ToolTip.Tip="What orders the list. The formula is the app's own rating, from the heroes' traits and what the item does.&#10;Match data ranks by how much more often players win with each item in real matches against these enemies,&#10;plus its hero fit: how much more your hero wins with it than everyone who builds it. 'Formula + match data' scales the two to count equally and adds them.&#10;The data never changes the formula score. Needs match data (Data → Download Match Data).">
                            <!-- Gold names the formula here, so a hovered or chosen option stays plain. -->
                            <ComboBox.Resources>
                                <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="TextBrush"/>
                                <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="TextBrush"/>
                            </ComboBox.Resources>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="match:RankPreset">
                                    <controls:RichText Spans="{Binding MenuLabel, Converter={x:Static controls:OpinionTerms.Converter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="match:RankPreset">
                                    <controls:RichText Spans="{Binding Label, Converter={x:Static controls:OpinionTerms.Converter}}"/>
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                        </ComboBox>

                        <!-- Shows or puts away the search box below. It keeps focus off itself, so a click on it while the box
                             has focus doesn't first close an empty box through its lost focus. -->
                        <Button x:Name="ItemSearchToggle"
                                Grid.Row="1"
                                Grid.Column="2"
                                Focusable="False"
                                Margin="8,0,0,0"
                                VerticalAlignment="Stretch"
                                Classes="glyph"
                                Classes.open="{Binding Results.IsSearchOpen}"
                                Command="{Binding ToggleItemSearchCommand}"
                                IsEnabled="{Binding !IsMatchEmpty}"
                                ToolTip.Tip="Search the recommended items, or put the search away (Ctrl+F)">
                            <!-- Drawn at the glyph's own 16px size, about as wide as the funnel and centred on its box, with a stroke that matches the funnel's weight. -->
                            <Path Data="M7,1.2 A5.8,5.8 0 1 1 7,12.8 A5.8,5.8 0 1 1 7,1.2 Z M11.1,11.1 L14.6,14.6"
                                  Stretch="None"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"/>
                        </Button>

                        <!-- A funnel, filled while a filter changes the list out of sight. -->
                        <Button x:Name="FiltersButton"
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="8,0,0,0"
                                VerticalAlignment="Stretch"
                                Classes="glyph"
                                Classes.active="{Binding HasActiveFilters}"
                                ToolTip.Tip="{Binding FiltersButtonTip}">
                            <Path Data="M1.5,2.5 H14.5 L9.5,8.5 V13.5 L6.5,11.5 V8.5 Z" Stretch="Uniform"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="320" Spacing="8">
                                        <TextBlock Classes="section" Text="SHOW"/>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Cutoffs}"
                                                  SelectedItem="{Binding SelectedCutoff}"
                                                  ToolTip.Tip="Hide items scoring below this share of the top item's score,&#10;so only the real contenders are left. 'Every item' also lists items at 0 or below."/>
                                        <CheckBox Content="Group by tier"
                                                  IsChecked="{Binding ByTier}"
                                                  ToolTip.Tip="Group into collapsible tier sections instead of one ranked list"/>
                                        <CheckBox Content="Show each item's tier and price"
                                                  IsChecked="{Binding ShowTiers}"
                                                  ToolTip.Tip="Name each item's shop tier and its price in souls beside it.&#10;Grouped by tier, the section headers name them instead."/>
                                        <CheckBox Content="Lean toward heroes ahead on net worth"
                                                  IsChecked="{Binding ByNetWorth}"
                                                  IsEnabled="{Binding Board.HasNetWorth}"
                                                  ToolTip.Tip="Counters to fed enemies and items for fed allies (or a fed you) count for more,&#10;by up to 30%. Needs a net worth reading, from Detect."
                                                  ToolTip.ShowOnDisabled="True"/>
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="section" Text="HIDE"/>
                                            <CheckBox Content="{x:Static match:MatchViewModel.HideRarelyBuiltLabel}"
                                                      IsChecked="{Binding HideRarelyBuilt}"
                                                      ToolTip.Tip="{x:Static match:MatchViewModel.HideRarelyBuiltTip}"/>
                                            <CheckBox Content="{x:Static match:MatchViewModel.HideDisagreedLabel}"
                                                      IsChecked="{Binding HideDisagreed}"
                                                      IsEnabled="{Binding RanksByBoth}"
                                                      ToolTip.Tip="{x:Static match:MatchViewModel.HideDisagreedTip}"
                                                      ToolTip.ShowOnDisabled="True"/>
                                        </StackPanel>

                                        <Border Classes="hline" Margin="0,4"/>

                                        <StackPanel Spacing="8" DataContext="{Binding DataRanks}" x:DataType="match:DataRanksViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="section"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DataBrush}"
                                                           Text="MATCH DATA FROM"/>
                                                <controls:InfoBadge VerticalAlignment="Center"
                                                                    ToolTip.Tip="{Binding InfoTip}"
                                                                    IsVisible="{Binding CanFilter}"/>
                                            </StackPanel>
                                            <StackPanel Spacing="6" IsVisible="{Binding !CanFilter}">
                                                <TextBlock Classes="faint" TextWrapping="Wrap" Text="Leaning toward your ranks needs the rank groups downloaded."/>
                                                <Button HorizontalAlignment="Left" Content="Download the rank groups…" Command="{Binding DownloadRanksCommand}"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8" IsEnabled="{Binding CanFilter}">
                                                <RadioButton GroupName="DataRanks" Content="Every match, ranked or not" IsChecked="{Binding EveryMatch}"/>
                                                <RadioButton GroupName="DataRanks" Content="Leaning toward ranks" IsChecked="{Binding RankedOnly}"/>
                                                <Grid ColumnDefinitions="*,Auto,*" Margin="28,0,0,0" IsEnabled="{Binding RankedOnly}">
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Ranks}" SelectedItem="{Binding From}"/>
                                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="to"/>
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding Ranks}" SelectedItem="{Binding To}"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <controls:SearchBox x:Name="ItemSearchBox"
                                        DockPanel.Dock="Top"
                                        Margin="0,0,0,8"
                                        Watermark="Search items..."
                                        Text="{Binding Results.SearchText}"
                                        IsVisible="{Binding Results.IsSearchOpen}"/>
                    <Panel>
                        <Panel IsVisible="{Binding !ShowsQuickStart}">
                            <results:ResultsView DataContext="{Binding Results}"/>
                        </Panel>

                        <!-- Nothing picked yet: the three ways to fill the match, in place of an empty list. -->
                        <StackPanel x:Name="QuickStart"
                                    IsVisible="{Binding ShowsQuickStart}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="460"
                                    Spacing="12">
                            <TextBlock Classes="h2" HorizontalAlignment="Center" Text="Who's in your match?"/>
                            <TextBlock Classes="dim"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="Detect reads every hero off Deadlock's top bar while a match is on screen. Or import a finished match by its ID, or pick the heroes yourself."/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
                                <Button Classes="primary" Command="{Binding DetectCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Detect from screen" VerticalAlignment="Center"/>
                                        <TextBlock Classes="shortcut"
                                                   Text="{Binding Board.DetectKey}"
                                                   IsVisible="{Binding Board.DetectKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Import a match…" Command="{Binding ImportCommand}"/>
                                <Button Content="Pick heroes" Command="{Binding PickHeroesCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

            <Border Grid.Column="2" Classes="card">
                <explain:ExplainView DataContext="{Binding Explain}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
