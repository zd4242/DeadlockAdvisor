<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:match="using:DeadlockAdvisor.Features.Match"
             xmlns:board="using:DeadlockAdvisor.Features.Match.Board"
             xmlns:results="using:DeadlockAdvisor.Features.Match.Results"
             xmlns:explain="using:DeadlockAdvisor.Features.Match.Explain"
             x:Class="DeadlockAdvisor.Features.Match.MatchView"
             x:DataType="match:MatchViewModel">

    <Grid RowDefinitions="Auto,Auto,12,*" Margin="12">
        <board:RosterView DataContext="{Binding Board}"/>

        <Panel Grid.Row="1" Margin="0,12,0,0" IsVisible="{Binding Board.IsPickerOpen}">
            <board:MatchBoardView DataContext="{Binding Board}"/>
        </Panel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Classes="card">
                <DockPanel>
                    <!-- Ranking, cutoff and layout, shared by both result tabs; the options wrap under
                         the tabs when the column is narrow. -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <ListBox Classes="segmented" SelectedIndex="{Binding ResultsTab}" VerticalAlignment="Top">
                            <ListBoxItem Content="Lane Phase"/>
                            <ListBoxItem Content="Full Match"/>
                        </ListBox>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Margin="8,0,0,0" ItemSpacing="8" LineSpacing="6">
                            <ComboBox VerticalAlignment="Center"
                                      ItemsSource="{Binding Ranks}"
                                      SelectedItem="{Binding SelectedRank}"
                                      IsEnabled="{Binding HasMatchData}"
                                      ToolTip.ShowOnDisabled="True"
                                      ToolTip.Tip="What orders the list. Match data ranks by real-match lifts (enemies, plus a third&#10;of yours); 'agree' keeps only items both rate above 0. The data is never added&#10;into the formula score. Needs match data (Data → Fetch Match Stats)."/>
                            <DropDownButton VerticalAlignment="Center"
                                            DataContext="{Binding DataRanks}"
                                            x:DataType="match:DataRanksViewModel"
                                            Content="{Binding Label}"
                                            IsEnabled="{Binding CanFilter}"
                                            ToolTip.ShowOnDisabled="True"
                                            ToolTip.Tip="Which ranks the match data comes from, changed on the spot.&#10;Needs match stats fetched split by rank (Data → Fetch Match Stats).">
                                <DropDownButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Width="320" Spacing="8">
                                            <TextBlock Classes="section" Text="MATCH DATA FROM"/>
                                            <RadioButton GroupName="DataRanks" Content="Every match, ranked or not" IsChecked="{Binding EveryMatch}"/>
                                            <RadioButton GroupName="DataRanks" Content="Ranked matches only, from" IsChecked="{Binding RankedOnly}"/>
                                            <Grid ColumnDefinitions="*,Auto,*" Margin="28,0,0,0" IsEnabled="{Binding RankedOnly}">
                                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Ranks}" SelectedItem="{Binding From}"/>
                                                <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="to"/>
                                                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding Ranks}" SelectedItem="{Binding To}"/>
                                            </Grid>
                                            <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding Status}"/>
                                            <TextBlock Classes="faint"
                                                       TextWrapping="Wrap"
                                                       Text="A match's rank is both teams' average; Ascendant includes Eternus. Unranked matches have no rank, so only 'every match' has them. Fewer matches make noisier numbers, and a kind of lift that turns to noise is left out."/>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <ComboBox VerticalAlignment="Center"
                                      ItemsSource="{Binding Cutoffs}"
                                      SelectedItem="{Binding SelectedCutoff}"
                                      ToolTip.Tip="Hide items scoring below this share of the top item's score,&#10;so only the real contenders are left. 'Every item' also lists items at 0 or below."/>
                            <ToggleButton VerticalAlignment="Center"
                                          Content="By tier"
                                          IsChecked="{Binding ByTier}"
                                          ToolTip.Tip="Group into collapsible tier sections instead of one ranked list"/>
                            <ToggleButton VerticalAlignment="Center"
                                          Content="By net worth"
                                          IsChecked="{Binding ByNetWorth}"
                                          IsEnabled="{Binding Board.HasNetWorth}"
                                          ToolTip.Tip="Lean scores toward the heroes ahead on net worth: counters to fed enemies&#10;and items for fed allies (or a fed you) count for more, by up to 30%.&#10;Needs a net worth reading, from Detect."
                                          ToolTip.ShowOnDisabled="True"/>
                        </WrapPanel>
                    </Grid>
                    <Panel>
                        <Panel IsVisible="{Binding IsLaneTab}">
                            <results:ResultsView DataContext="{Binding LaneResults}"/>
                        </Panel>
                        <Panel IsVisible="{Binding IsFullTab}">
                            <results:ResultsView DataContext="{Binding FullResults}"/>
                        </Panel>
                    </Panel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

            <Border Grid.Column="2" Classes="card">
                <explain:ExplainView DataContext="{Binding Explain}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
