<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:explain="using:DeadlockAdvisor.Features.Match.Explain"
             xmlns:controls="using:DeadlockAdvisor.Controls"
             xmlns:art="using:DeadlockAdvisor.Controls.Art"
             xmlns:card="using:DeadlockAdvisor.Features.Shared.ItemCard"
             xmlns:theme="using:DeadlockAdvisor.Theme"
             x:Class="DeadlockAdvisor.Features.Match.Explain.ExplainView"
             x:DataType="explain:ExplainViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.faintText">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="section" Text="WHY THIS ITEM?"/>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
            <art:ArtImage Width="40"
                          Height="40"
                          Margin="0,0,8,0"
                          Kind="Item"
                          ArtId="{Binding ItemId}"
                          ArtName="{Binding ItemName}"
                          Tint="{Binding ShopColor}"
                          IsVisible="{Binding HasItem}"
                          card:ItemCardHover.ItemId="{Binding ItemId}"/>
            <TextBlock Grid.Column="1"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Classes.dim="{Binding !HasItem}"
                       Text="{Binding ItemName}"/>
            <controls:SignedAmount Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   IsBold="True"
                                   Value="{Binding Total.Shown}"
                                   Text="{Binding Total.Text}"
                                   ToolTip.Tip="{Binding Total.Tip}"
                                   IsVisible="{Binding HasItem}"/>
        </Grid>

        <controls:RichText DockPanel.Dock="Top"
                           Classes="dim"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Spans="{Binding Verdict, Converter={x:Static controls:OpinionTerms.Converter}}"
                           ToolTip.Tip="Ranked by the formula and the match data added together, each in units of how far it typically strays from 0 in line-ups like this one."
                           IsVisible="{Binding Verdict, Converter={x:Static ObjectConverters.IsNotNull}}"/>

        <Border DockPanel.Dock="Top" Classes="hline" Margin="0,6,0,6"/>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4" Margin="0,0,4,0" Grid.IsSharedSizeScope="True">
                <TextBlock Classes="hint"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasItem}"
                           Text="{x:Static explain:ExplainViewModel.IdleHint}"/>

                <TextBlock Classes="hint"
                           TextWrapping="Wrap"
                           IsVisible="{Binding NoContributions}"
                           Text="No hero in this view triggers any of this item's rules."/>

                <ItemsControl ItemsSource="{Binding Contributions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="explain:ContributionCard">
                            <Border Classes="inset" Margin="0,0,0,4">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                        <TextBlock Text="{Binding HeroName}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <controls:Badge Grid.Column="1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding RelationText}"
                                                        Color="{Binding RelationColor}"/>
                                        <TextBlock Grid.Column="2"
                                                   Classes="faintText"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Note}"
                                                   ToolTip.Tip="{Binding NoteTip}"/>
                                        <controls:SignedAmount Grid.Column="3"
                                                               VerticalAlignment="Center"
                                                               IsBold="True"
                                                               Value="{Binding Amount.Shown}"
                                                               Text="{Binding Amount.Text}"
                                                               ToolTip.Tip="{Binding Amount.Tip}"/>
                                    </Grid>
                                    <!-- One line per trait with the multiplication and its share in right-aligned
                                         columns so the numbers stack and scan, then where the coefficient came from
                                         on its own line beneath, so a long source wraps across the card's full
                                         width instead of squeezing between the name and the numbers. -->
                                    <ItemsControl ItemsSource="{Binding Traits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="explain:TraitLine">
                                                <Grid Margin="0,0,0,4" RowDefinitions="Auto,Auto">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Arithmetic"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Share"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding TraitName}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Classes="faintText"
                                                               Margin="10,0,0,0"
                                                               HorizontalAlignment="Right"
                                                               Text="{Binding Arithmetic}"/>
                                                    <controls:SignedAmount Grid.Column="2"
                                                                           Margin="10,0,0,0"
                                                                           HorizontalAlignment="Right"
                                                                           Value="{Binding Share.Shown}"
                                                                           Text="{Binding Share.Text}"
                                                                           ToolTip.Tip="{Binding Share.Tip}"
                                                                           Color="{x:Static theme:Palette.Text}"/>
                                                    <TextBlock Grid.Row="1"
                                                               Grid.ColumnSpan="2"
                                                               Classes="faintText"
                                                               Margin="12,1,0,0"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Source}"
                                                               ToolTip.Tip="{Binding SourceTip}"
                                                               IsVisible="{Binding Source, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Content="{Binding MatchData}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="explain:MatchDataCard">
                            <Border Classes="inset">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Match data" FontWeight="Bold" Foreground="{DynamicResource DataBrush}"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Totals}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="12"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="explain:DataTotal">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding Word}"
                                                                   Foreground="{Binding Brush}"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"/>
                                                        <controls:SignedAmount VerticalAlignment="Center"
                                                                               IsBold="True"
                                                                               Value="{Binding Value.Shown}"
                                                                               Text="{Binding Value.Text}"
                                                                               ToolTip.Tip="{Binding Value.Tip}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <TextBlock Classes="dim"
                                               TextWrapping="Wrap"
                                               Text="{Binding Relevance}"
                                               IsVisible="{Binding Relevance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="explain:DataLine">
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DataHero"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DataShare"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Classes="dim" Text="{Binding HeroName}" VerticalAlignment="Center"/>
                                                    <controls:Badge Grid.Column="1"
                                                                    Margin="10,0,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Text="{Binding RelationText}"
                                                                    Color="{Binding RelationColor}"/>
                                                    <TextBlock Grid.Column="2"
                                                               Classes="faintText"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Detail}"/>
                                                    <controls:SignedAmount Grid.Column="3"
                                                                           Margin="10,0,0,0"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           Value="{Binding Share.Shown}"
                                                                           Text="{Binding Share.Text, StringFormat='{}{0} pts'}"
                                                                           ToolTip.Tip="{Binding Share.Tip}"
                                                                           Color="{x:Static theme:Palette.Text}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="faintText" TextWrapping="Wrap" Text="{Binding Note}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
