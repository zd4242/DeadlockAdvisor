<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:explain="using:DeadlockAdvisor.Features.Match.Explain"
             xmlns:controls="using:DeadlockAdvisor.Controls"
             xmlns:art="using:DeadlockAdvisor.Controls.Art"
             xmlns:card="using:DeadlockAdvisor.Features.Shared.ItemCard"
             xmlns:theme="using:DeadlockAdvisor.Theme"
             x:Class="DeadlockAdvisor.Features.Match.Explain.ExplainView"
             x:DataType="explain:ExplainViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.faintText, controls|RichText.faintText">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>
        <Style Selector="art|ArtImage.heroIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Without the math (Settings → General), each line says what it is and how much it counts, and the rest shows on hover. -->
        <Style Selector="DockPanel.simple :is(Control).math">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DockPanel.simple Grid.cardTitle" x:DataType="explain:ContributionCard">
            <Setter Property="ToolTip.Tip" Value="{Binding NoteWithTip}"/>
        </Style>
        <Style Selector="DockPanel.simple Grid.traitLine" x:DataType="explain:TraitLine">
            <Setter Property="ToolTip.Tip" Value="{Binding Working}"/>
        </Style>
        <Style Selector="DockPanel.simple Grid.dataLine" x:DataType="explain:DataLine">
            <Setter Property="ToolTip.Tip" Value="{Binding Detail}"/>
        </Style>
        <!-- Only with an item, so the idle title offers nothing to go to. The formula only while the editors are shown. -->
        <Style Selector="Grid.itemHeader.hasItem">
            <Setter Property="ContextMenu">
                <ContextMenu x:DataType="explain:ExplainViewModel">
                    <MenuItem Header="Go to Item Formula"
                              Command="{Binding OpenFormulaCommand}"
                              CommandParameter="{Binding ItemId}"
                              IsVisible="{Binding ShowsEditors}"/>
                    <controls:WikiMenuItem Page="{Binding ItemName}"/>
                </ContextMenu>
            </Setter>
        </Style>
        <!-- A template, so every line gets a menu of its own. Only for a hero's line, and only while the editors are shown. -->
        <Style Selector="DockPanel.editors Grid.traitLine.hasCell">
            <Setter Property="ContextMenu">
                <Template>
                    <ContextMenu x:DataType="explain:TraitLine">
                        <MenuItem Header="Go to Hero Trait"
                                  Command="{Binding $parent[explain:ExplainView].((explain:ExplainViewModel)DataContext).OpenTraitCommand}"
                                  CommandParameter="{Binding Cell}"/>
                    </ContextMenu>
                </Template>
            </Setter>
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="explain:MatchDataCard">
            <Border Classes="inset">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="Match data" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource DataBrush}"/>
                        <controls:InfoBadge Grid.Column="1"
                                            Margin="6,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding Info}"
                                            IsVisible="{Binding Info, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Totals}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="explain:DataTotal">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Word}"
                                                   Foreground="{Binding Brush}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <controls:SignedAmount VerticalAlignment="Center"
                                                               IsBold="True"
                                                               Value="{Binding Value.Shown}"
                                                               Text="{Binding Value.Text}"
                                                               ToolTip.Tip="{Binding Value.Tip}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <TextBlock Classes="dim"
                               TextWrapping="Wrap"
                               Text="{Binding Relevance}"
                               IsVisible="{Binding Relevance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="explain:DataLine">
                                <Grid Classes="dataLine" Margin="0,0,0,3" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DataHero"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DataShare"/>
                                    </Grid.ColumnDefinitions>
                                    <art:ArtImage Classes="heroIcon"
                                                  Kind="Hero"
                                                  ArtId="{Binding HeroId}"
                                                  ArtName="{Binding HeroName}"/>
                                    <TextBlock Grid.Column="1" Classes="dim" Text="{Binding HeroName}" VerticalAlignment="Center"/>
                                    <controls:Badge Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding RelationText}"
                                                    Color="{Binding RelationColor}"/>
                                    <TextBlock Grid.Column="3"
                                               Classes="faintText math"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding Detail}"/>
                                    <controls:SignedAmount Grid.Column="4"
                                                           Margin="10,0,0,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Value="{Binding Share.Shown}"
                                                           Text="{Binding Share.Text, StringFormat='{}{0} pts'}"
                                                           ToolTip.Tip="{Binding Share.Tip}"
                                                           Color="{x:Static theme:Palette.Text}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <DockPanel Classes.simple="{Binding !ShowsMath}" Classes.editors="{Binding ShowsEditors}">
        <TextBlock DockPanel.Dock="Top" Classes="section" Text="WHY THIS ITEM?"/>

        <Grid DockPanel.Dock="Top"
              Classes="itemHeader"
              Classes.hasItem="{Binding HasItem}"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,8,0,0"
              Background="Transparent">
            <art:ArtImage Width="40"
                          Height="40"
                          Margin="0,0,8,0"
                          Kind="Item"
                          ArtId="{Binding ItemId}"
                          ArtName="{Binding ItemName}"
                          Tint="{Binding ShopColor}"
                          IsVisible="{Binding HasItem}"
                          card:ItemCardHover.ItemId="{Binding ItemId}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontWeight="Bold"
                           TextWrapping="Wrap"
                           Classes.dim="{Binding !HasItem}"
                           Text="{Binding ItemName}"/>
                <controls:VerdictText Verdict="{Binding Verdict}"
                                      ToolTip.Tip="{x:Static explain:ExplainText.VerdictTip}"
                                      IsVisible="{Binding Verdict, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
            <controls:SignedAmount Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   IsBold="True"
                                   Value="{Binding Headline.Shown}"
                                   Text="{Binding Headline.Text}"
                                   ToolTip.Tip="{Binding Headline.Tip}"
                                   IsVisible="{Binding HasItem}"/>
        </Grid>

        <Border DockPanel.Dock="Top" Classes="hline" Margin="0,8,0,6"/>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4" Margin="0,0,4,0" Grid.IsSharedSizeScope="True">
                <TextBlock Classes="hint"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasItem}"
                           Text="{x:Static explain:ExplainViewModel.IdleHint}"/>

                <!-- Ranked by the match data alone, its card leads and the formula's follow. -->
                <ContentControl Content="{Binding MatchData}" Margin="0,0,0,8">
                    <ContentControl.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="MatchDataFirst"/>
                            <Binding Path="MatchData" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                        </MultiBinding>
                    </ContentControl.IsVisible>
                </ContentControl>

                <TextBlock Classes="hint"
                           TextWrapping="Wrap"
                           IsVisible="{Binding NoContributions}"
                           Text="No hero in this view triggers any of this item's rules."/>

                <!-- Lined up with the cards' own amounts, which add up to it. -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Margin="10,0,10,2"
                      Background="Transparent"
                      ToolTip.Tip="{Binding FormulaTotalTip}"
                      IsVisible="{Binding ShowsFormulaTotal}">
                    <TextBlock Text="Formula" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource FormulaBrush}"/>
                    <!-- The cards add up in points; the verdict above counts them in typical scores. -->
                    <TextBlock Grid.Column="1"
                               Classes="faintText"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding FormulaConversion}"
                               IsVisible="{Binding FormulaConversion, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <controls:SignedAmount Grid.Column="2"
                                           VerticalAlignment="Center"
                                           IsBold="True"
                                           Value="{Binding FormulaTotal.Shown}"
                                           Text="{Binding FormulaTotal.Text}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Contributions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="explain:ContributionCard">
                            <Border Classes="inset" Margin="0,0,0,4">
                                <StackPanel Spacing="6">
                                    <Grid Classes="cardTitle" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Background="Transparent">
                                        <art:ArtImage Classes="heroIcon"
                                                      Kind="Hero"
                                                      ArtId="{Binding HeroId}"
                                                      ArtName="{Binding HeroName}"
                                                      IsVisible="{Binding HeroId, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding HeroName}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <controls:Badge Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding RelationText}"
                                                        Color="{Binding RelationColor}"/>
                                        <controls:InfoBadge Grid.Column="3"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="{Binding Info}"
                                                            IsVisible="{Binding Info, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <TextBlock Grid.Column="4"
                                                   Classes="faintText math"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Note}"
                                                   ToolTip.Tip="{Binding NoteTip}"/>
                                        <controls:SignedAmount Grid.Column="5"
                                                               VerticalAlignment="Center"
                                                               IsBold="True"
                                                               Value="{Binding Amount.Shown}"
                                                               Text="{Binding Amount.Text}"
                                                               ToolTip.Tip="{Binding Amount.Tip}"/>
                                    </Grid>
                                    <!-- One line per trait with the multiplication and its share in right-aligned
                                         columns so the numbers stack and scan, then where the coefficient came from
                                         on its own line beneath, so a long source wraps across the card's full
                                         width instead of squeezing between the name and the numbers. Without the
                                         math, a hero's only line leaves its share to the card's amount. -->
                                    <ItemsControl ItemsSource="{Binding Traits}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="9"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="explain:TraitLine">
                                                <Grid Classes="traitLine"
                                                      Classes.hasCell="{Binding Cell, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                      RowDefinitions="Auto,Auto"
                                                      Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Arithmetic"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Share"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock TextWrapping="Wrap" Text="{Binding TraitName}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Classes="faintText math"
                                                               Margin="10,0,0,0"
                                                               HorizontalAlignment="Right"
                                                               Text="{Binding Arithmetic}"/>
                                                    <controls:SignedAmount Grid.Column="2"
                                                                           Classes.math="{Binding IsSole}"
                                                                           Margin="10,0,0,0"
                                                                           HorizontalAlignment="Right"
                                                                           Value="{Binding Share.Shown}"
                                                                           Text="{Binding Share.Text}"
                                                                           ToolTip.Tip="{Binding Share.Tip}"
                                                                           Color="{x:Static theme:Palette.Text}"/>
                                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="math">
                                                        <controls:RichText Classes="faintText"
                                                                   Margin="12,2,0,0"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Spans="{Binding Source}"
                                                                   ToolTip.Tip="{Binding SourceTip}"
                                                                   IsVisible="{Binding Source, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Content="{Binding MatchData}" IsVisible="{Binding !MatchDataFirst}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
