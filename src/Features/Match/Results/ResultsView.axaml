<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:results="using:DeadlockAdvisor.Features.Match.Results"
             xmlns:controls="using:DeadlockAdvisor.Controls"
             xmlns:art="using:DeadlockAdvisor.Controls.Art"
             xmlns:card="using:DeadlockAdvisor.Features.Shared.ItemCard"
             xmlns:theme="using:DeadlockAdvisor.Theme"
             xmlns:behaviors="using:DeadlockAdvisor.Behaviors"
             x:Class="DeadlockAdvisor.Features.Match.Results.ResultsView"
             x:DataType="results:ResultsViewModel">

    <UserControl.Styles>
        <!-- Green or red by its sign, as amounts are everywhere: gold names the formula, and this is often more than it. -->
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}"/>
        </Style>
        <Style Selector="TextBlock.value.zero">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>
        <Style Selector="controls|ScoreBar.pair">
            <Setter Property="Height" Value="4"/>
        </Style>
        <!-- An item a search found that the filters leave out of the list. -->
        <Style Selector="Border.result.hidden">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <!-- Beside the name and its badges while the list has room for them; below them, as a line of its own, when it doesn't. -->
        <Style Selector="Border.result StackPanel.data">
            <Setter Property="Grid.Column" Value="5"/>
            <Setter Property="Margin" Value="8,0,10,0"/>
        </Style>
        <Style Selector="ItemsControl.narrow Border.result StackPanel.data">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style Selector="ItemsControl.narrow Border.result Border.vline">
            <Setter Property="Width" Value="0"/>
        </Style>
        <Style Selector="ItemsControl.narrow Border.result TextBlock.name">
            <Setter Property="MaxWidth" Value="170"/>
        </Style>
        <!-- A template, so every row gets a menu of its own. The formula only while the editors are shown. -->
        <Style Selector="Border.result">
            <Setter Property="ContextMenu">
                <Template>
                    <ContextMenu x:DataType="results:ResultRowViewModel">
                        <MenuItem Header="Go to Item Formula"
                                  Command="{Binding $parent[results:ResultsView].((results:ResultsViewModel)DataContext).OpenFormulaCommand}"
                                  CommandParameter="{Binding ItemId}"
                                  IsVisible="{Binding $parent[results:ResultsView].((results:ResultsViewModel)DataContext).ShowsEditors}"/>
                        <controls:WikiMenuItem Page="{Binding Name}"/>
                    </ContextMenu>
                </Template>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Panel>
        <TextBlock Classes="hint"
                   Text="{Binding EmptyHint}"
                   IsVisible="{Binding IsEmpty}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MaxWidth="460"/>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsEmpty}">
            <ItemsControl x:Name="List"
                          behaviors:Responsive.NarrowBelow="560"
                          ItemsSource="{Binding Entries}"
                          Margin="0,0,4,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="results:ResultRowViewModel">
                        <Border Classes="result"
                                Classes.selected="{Binding IsSelected}"
                                Classes.hidden="{Binding HiddenReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Margin="0,0,0,4"
                                Padding="8,7,10,7">
                            <Grid ColumnDefinitions="Auto,*">
                                <art:ArtImage Width="34"
                                              Height="34"
                                              Kind="Item"
                                              ArtId="{Binding ItemId}"
                                              ArtName="{Binding Name}"
                                              Tint="{Binding ShopColor}"
                                              VerticalAlignment="Center"
                                              card:ItemCardHover.ItemId="{Binding ItemId}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="5" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="name"
                                                       Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <controls:Badge VerticalAlignment="Center"
                                                            Text="{Binding TierText}"
                                                            Color="{Binding TierColor}"
                                                            IsVisible="{Binding ShowsTier}"
                                                            ToolTip.Tip="The shop tier, and its price in souls"/>
                                        </StackPanel>
                                        <controls:Badge Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="DATA ★"
                                                        Color="{x:Static theme:Palette.Data}"
                                                        IsVisible="{Binding IsStandout}"
                                                        ToolTip.Tip="{x:Static results:ResultRowViewModel.StandoutTip}"/>
                                        <controls:Badge Grid.Column="2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="DISAGREE"
                                                        Color="{x:Static theme:Palette.TextDim}"
                                                        IsVisible="{Binding Disagrees}"
                                                        ToolTip.Tip="{Binding DisagreeTip}"/>
                                        <controls:Badge Grid.Column="3"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="RARELY BUILT"
                                                        Color="{x:Static theme:Palette.TextDim}"
                                                        IsVisible="{Binding IsRarelyBuilt}"
                                                        ToolTip.Tip="{Binding RarelyBuiltTip}"/>
                                        <controls:DataText Classes="data"
                                                           VerticalAlignment="Center"
                                                           Data="{Binding Data}"
                                                           IsVisible="{Binding HasData}"
                                                           ToolTip.Tip="{Binding DataTip}"/>
                                        <Border Grid.Column="6"
                                                Classes="vline"
                                                Height="18"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasData}"/>
                                        <!-- A fixed width, so the scores line up down the list whatever their length. -->
                                        <Panel Grid.Column="7"
                                               MinWidth="58"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Background="Transparent"
                                               ToolTip.Tip="{Binding Score.Tip}">
                                            <TextBlock Classes="value"
                                                       Classes.zero="{Binding IsZero}"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Score.Text}"
                                                       IsVisible="{Binding !IsNegative}"/>
                                            <controls:SignedAmount HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="15"
                                                                   IsBold="True"
                                                                   Value="{Binding Score.Shown}"
                                                                   Text="{Binding Score.Text}"
                                                                   IsVisible="{Binding IsNegative}"/>
                                        </Panel>
                                    </Grid>
                                    <StackPanel Spacing="2" Background="Transparent" ToolTip.Tip="{Binding BarTip}">
                                        <controls:ScoreBar Classes.pair="{Binding HasDataBar}" Fraction="{Binding Fraction}" Color="{Binding BarColor}"/>
                                        <controls:ScoreBar Classes="pair"
                                                           Color="{x:Static theme:Palette.Data}"
                                                           Fraction="{Binding DataFraction}"
                                                           IsVisible="{Binding HasDataBar}"/>
                                    </StackPanel>
                                    <TextBlock Classes="dim"
                                               TextWrapping="Wrap"
                                               Text="{Binding HiddenReason}"
                                               IsVisible="{Binding HiddenReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="results:SectionHeaderViewModel">
                        <StackPanel Classes="tierHeader"
                                    Margin="0,10,0,6"
                                    Spacing="2"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    ToolTip.Tip="{Binding ToolTipText}">
                            <Grid ColumnDefinitions="12,Auto,Auto,*">
                                <TextBlock Text="{Binding Chevron}"
                                           Foreground="{Binding Brush}"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Classes="section"
                                           Margin="8,0,0,0"
                                           Text="{Binding Title}"
                                           Foreground="{Binding Brush}"
                                           VerticalAlignment="Center"/>
                                <controls:Badge Grid.Column="2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding CountText}"
                                                Color="{Binding Color}"/>
                            </Grid>
                            <TextBlock Classes="faint"
                                       Margin="20,0,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding Note}"
                                       IsVisible="{Binding HasNote}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Panel>
</UserControl>
