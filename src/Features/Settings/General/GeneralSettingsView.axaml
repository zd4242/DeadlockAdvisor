<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:DeadlockAdvisor.Features.Settings"
             xmlns:general="using:DeadlockAdvisor.Features.Settings.General"
             x:Class="DeadlockAdvisor.Features.Settings.General.GeneralSettingsView"
             x:DataType="general:GeneralSettingsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.hint.invalid">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        </Style>
        <!-- The zoom stepper: − and + either side of the level, on a recessed track -->
        <Style Selector="Border.segmented Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.segmented Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <TextBlock Classes="section" Text="DISPLAY"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Zoom"
                                     Description="Ctrl + mouse wheel, Ctrl+= and Ctrl+- zoom from anywhere in the window. The wheel alone does it over the zoom buttons in the status bar.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="segmented">
                            <StackPanel>
                                <Button Content="−" AutomationProperties.Name="Zoom out" ToolTip.Tip="Zoom out (Ctrl+-)" Command="{Binding ZoomOutCommand}"/>
                                <TextBlock x:Name="ZoomLevel"
                                           Text="{Binding ZoomText}"
                                           Width="52"
                                           TextAlignment="Center"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Content="+" AutomationProperties.Name="Zoom in" ToolTip.Tip="Zoom in (Ctrl+=)" Command="{Binding ZoomInCommand}"/>
                            </StackPanel>
                        </Border>
                        <Button Classes="ghost" Content="Reset" ToolTip.Tip="Back to 100% (Ctrl+0)" Command="{Binding ResetZoomCommand}"/>
                    </StackPanel>
                </settings:SettingRow>
                <settings:SettingRow Title="Show the math in Why this item?"
                                     Description="Each line's arithmetic, where its coefficient comes from, and what scaled a hero's share, such as best-target rank or net worth. Turned off, the panel says who counts and by how much, and hovering a line shows the rest.">
                    <ToggleSwitch IsChecked="{Binding ShowExplainMath}"/>
                </settings:SettingRow>
                <settings:SettingRow Title="Offer random matches"
                                     Description="The match bar's ⋯ menu can fill the match with random heroes, for trying things out. Their keys only work while this is on.">
                    <ToggleSwitch IsChecked="{Binding ShowRandomButtons}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="STARTUP"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Reopen on the last page"
                                     Description="Start on the page you were on when you closed the app, rather than on Match.">
                    <ToggleSwitch IsChecked="{Binding ReopenLastPage}"/>
                </settings:SettingRow>
                <settings:SettingRow Title="Reopen the last match"
                                     Description="Start with the heroes you had picked, rather than an empty match.">
                    <ToggleSwitch IsChecked="{Binding ReopenLastMatch}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="YOUR ACCOUNT"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Steam account"
                                     Description="Picks you out when you import a match by its ID. Paste your account ID, SteamID64 or steamcommunity.com/profiles/ link, or tick Remember when you import a match.">
                    <StackPanel Spacing="4" Width="240">
                        <TextBox x:Name="SteamAccount"
                                 Watermark="Account ID or profile link"
                                 Text="{Binding SteamAccountText}"/>
                        <TextBlock Classes="hint"
                                   TextWrapping="Wrap"
                                   Classes.invalid="{Binding IsSteamAccountInvalid}"
                                   Text="{Binding SteamAccountStatus}"/>
                    </StackPanel>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="SCORING MODEL"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Edit the scoring model"
                                     Description="Show the Hero Traits and Item Formulas tabs, where you rate heroes and write the rules items score by, Go to Item Formula when you right-click a recommendation, and the Model Tools in the Data menu.">
                    <ToggleSwitch IsChecked="{Binding ShowModelEditors}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
