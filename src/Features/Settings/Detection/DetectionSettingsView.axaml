<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:DeadlockAdvisor.Features.Settings"
             xmlns:detection="using:DeadlockAdvisor.Features.Settings.Detection"
             xmlns:controls="using:DeadlockAdvisor.Controls"
             x:Class="DeadlockAdvisor.Features.Settings.Detection.DetectionSettingsView"
             x:DataType="detection:DetectionSettingsViewModel">
    <UserControl.Styles>
        <!-- By class: the recorder is styled as the Button it is, so a type selector wouldn't reach it. -->
        <Style Selector="Button.key">
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.key:recording">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.key:recording /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <TextBlock Classes="section" Text="SHORTCUT"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Detect from any app" Description="{Binding DetectFromAnywhereDescription}">
                    <ToggleSwitch IsChecked="{Binding DetectFromAnywhere}"/>
                </settings:SettingRow>
                <settings:SettingRow Title="Switch here for a review"
                                     Description="When a detection from the game needs reviewing, needs you to click your hero, or couldn't read the screen, bring this window up. Off, it waits behind the game until you switch here or press Detect's key again, so the game keeps focus.">
                    <ToggleSwitch IsChecked="{Binding ComeUpForReview}"/>
                </settings:SettingRow>
                <settings:SettingRow Title="Sound when Detect from the game finishes"
                                     Description="A short system sound after you press Detect's key in the game: one tone when the match was read and applied, another when it needs a look or nothing could be read, which also flashes this window's taskbar button. Silent when this window is in front.">
                    <ToggleSwitch IsChecked="{Binding SoundOnDetect}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="SCOREBOARD"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Read the scoreboard while you hold its key" Description="{Binding ScoreboardDescription}">
                    <ToggleSwitch IsChecked="{Binding ReadBuildsOnTab}"/>
                </settings:SettingRow>
                <settings:SettingRow Title="Scoreboard key" Description="{Binding ScoreboardKeyNote}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost"
                                Content="Reset"
                                Command="{Binding ResetScoreboardKeyCommand}"
                                ToolTip.Tip="Back to Tab"/>
                        <controls:ShortcutRecorder Classes="key"
                                                   Gesture="{Binding ScoreboardKey}"
                                                   RecordedCommand="{Binding RecordScoreboardKeyCommand}"
                                                   IsRecording="{Binding IsRecordingScoreboardKey, Mode=OneWayToSource}"
                                                   ToolTip.Tip="Click, then press the key the game's scoreboard is on. Delete goes back to Tab; Esc keeps it."/>
                    </StackPanel>
                </settings:SettingRow>
                <settings:SettingRow Title="Keep the scoreboard captures"
                                     Description="Save each scoreboard read of your match, the whole board down to the items, in the captures folder of your data folder, at most one every 30 seconds, the latest 300 kept (about 400 MB), as material for reading items. They show every player's name, so don't share them.">
                    <ToggleSwitch IsChecked="{Binding KeepScoreboardCaptures}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="CAPTURE"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Minimize while capturing"
                                     Description="Get this window out of the way when it covers the game's top bar, so it isn't captured over it. It stays put when it's on another monitor or behind the game.">
                    <ToggleSwitch IsChecked="{Binding MinimizeToDetect}"/>
                </settings:SettingRow>
                <settings:SettingRow Title="Keep captures net worth couldn't be read from"
                                     Description="Saved with what was read in the captures folder of your data folder, the latest 20 kept, as material for fixing the reader.">
                    <ToggleSwitch IsChecked="{Binding KeepUnreadCaptures}"/>
                </settings:SettingRow>
                <settings:SettingRow Title="Keep the captures you apply"
                                     Description="Saved with the heroes you applied in the captures folder of your data folder, the latest 60 kept, as material for improving detection.">
                    <ToggleSwitch IsChecked="{Binding KeepDetectionCaptures}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="HERO STRIP"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Apply without asking when every hero is certain"
                                     Description="When every slot is read confidently or kept from your current match, apply it straight away. If your own slot can't be found, the heroes are applied all the same and you click yours on the match bar, which splits the teams. A Street Brawl's four empty slots count as read. Review beside Detect shows what was read. Anything less certain always opens the review.">
                    <ToggleSwitch IsChecked="{Binding AutoApplyDetect}"/>
                </settings:SettingRow>
                <settings:SettingRow Title="Remember my corrections as reference art"
                                     Description="When you correct a hero in the review, save that portrait under assets/topbar so the same look is recognised next time, such as a skin.">
                    <ToggleSwitch IsChecked="{Binding RememberCorrections}"/>
                </settings:SettingRow>
                <settings:SettingRow Title="Remembered positions" Description="{Binding RememberedLayouts}">
                    <Button Content="Forget" Command="{Binding ForgetLayoutsCommand}"
                            ToolTip.Tip="Search the whole top bar again on the next Detect, e.g. after changing the HUD scale"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
