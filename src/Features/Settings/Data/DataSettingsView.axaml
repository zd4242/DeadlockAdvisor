<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:DeadlockAdvisor.Features.Settings"
             xmlns:data="using:DeadlockAdvisor.Features.Settings.Data"
             xmlns:download="using:DeadlockAdvisor.Features.MainWindow.MatchDownload"
             x:Class="DeadlockAdvisor.Features.Settings.Data.DataSettingsView"
             xmlns:controls="using:DeadlockAdvisor.Controls"
             x:DataType="data:DataSettingsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ModeLabel" x:DataType="data:UpdateModeOption">
            <TextBlock Text="{Binding Label}"/>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Classes="section" Text="UPDATES"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Everything at once"
                                     Description="Look for a newer app, formulas and match data, and offer the match data and art you don't have yet. Also Data → Check for Updates (Ctrl+U).">
                    <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="ART"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Hero portraits and item icons" Description="{Binding ArtSummary}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Reload" Command="{Binding ReloadArtCommand}"
                                ToolTip.Tip="Pick up art added to the folder while the app is running"/>
                        <Button Content="Download…" Command="{Binding DownloadArtCommand}"
                                ToolTip.Tip="Fetch hero portraits, item icons and top-bar art from deadlock-api.com"/>
                    </StackPanel>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="MATCH DATA"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Item win rates from real matches" Description="{Binding MatchDataSummary}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Download…" Command="{Binding DownloadMatchDataCommand}"
                                ToolTip.Tip="See what a download would fetch and about how long it takes"/>
                        <Button Content="Check now" Command="{Binding CheckMatchDataCommand}"
                                ToolTip.Tip="Take any newer match data from the shared download, or say it's up to date"/>
                    </StackPanel>
                </settings:SettingRow>
                <settings:SettingRow Title="Keep match data up to date" Description="{Binding MatchDataModeDescription}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ListBox Classes="segmented" ItemsSource="{Binding MatchDataModes}" SelectedItem="{Binding MatchDataMode}"
                                 ItemTemplate="{StaticResource ModeLabel}"/>
                        <controls:InfoBadge VerticalAlignment="Center" ToolTip.Tip="{x:Static download:MatchDownloadViewModel.AutoUpdateInfo}"/>
                    </StackPanel>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="FORMULAS"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Hero ratings and item formulas" Description="{Binding ModelSummary}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="What's new" Command="{Binding ModelNotesCommand}"
                                ToolTip.Tip="What each published version changed"/>
                        <Button Classes="ghost" Content="Undo update" Command="{Binding UndoModelUpdateCommand}"
                                IsVisible="{Binding CanUndoModelUpdate}"
                                ToolTip.Tip="Put back the files the last formula update or reset replaced"/>
                        <Button Classes="ghost" Content="Reset…" Command="{Binding ResetModelCommand}"
                                ToolTip.Tip="Put files that differ from the published version back to it, choosing which"/>
                        <Button Content="Check now" Command="{Binding CheckModelCommand}"/>
                    </StackPanel>
                </settings:SettingRow>
                <settings:SettingRow Title="Keep the hero ratings and item formulas up to date" Description="{Binding FormulaModeDescription}">
                    <ListBox Classes="segmented" ItemsSource="{Binding FormulaModes}" SelectedItem="{Binding FormulaMode}"
                             ItemTemplate="{StaticResource ModeLabel}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="APP"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Version" Description="{Binding Version}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Releases" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding ReleasesUrl}"
                                ToolTip.Tip="Every version on GitHub, with what changed"/>
                        <Button Content="Check now" Command="{Binding CheckAppCommand}"/>
                    </StackPanel>
                </settings:SettingRow>
                <settings:SettingRow Title="Say when a new version is out" Description="{Binding AppModeDescription}">
                    <ListBox Classes="segmented" ItemsSource="{Binding AppModes}" SelectedItem="{Binding AppMode}"
                             ItemTemplate="{StaticResource ModeLabel}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="FOLDERS"/>
        <Border Classes="settings">
            <StackPanel>
                <settings:SettingRow Title="Data folder" Description="{Binding DataFolder}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Open" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding DataFolder}"/>
                        <Button Content="Change…" Command="{Binding ChangeDataFolderCommand}"
                                ToolTip.Tip="Use another folder holding data/ and assets/"/>
                    </StackPanel>
                </settings:SettingRow>
                <settings:SettingRow Title="Settings and log" Description="{Binding AppFolder}">
                    <Button Classes="ghost" Content="Open" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding AppFolder}"/>
                </settings:SettingRow>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
