<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mainWindow="using:DeadlockAdvisor.Features.MainWindow"
             x:Class="DeadlockAdvisor.Features.MainWindow.AppUpdateView"
             x:DataType="mainWindow:AppUpdateViewModel">

    <!-- A chip in the status bar, shaped like a download's, while a newer version is out. -->
    <UserControl.Styles>
        <Style Selector="Border.update">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,0,2,0"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style Selector="Border.update TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.update TextBlock.title">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.update TextBlock.link">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.result">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="Button.result:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.result:pointerover TextBlock.link">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <Style Selector="Button.close">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="update" IsVisible="{Binding IsShown}">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="title" Text="{Binding Label}" Margin="0,0,2,0"/>

            <!-- Out: install it, or see what's new. -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAvailable}">
                <Button x:Name="Update"
                        Classes="result"
                        AutomationProperties.Name="Update"
                        Command="{Binding UpdateCommand}"
                        ToolTip.Tip="{Binding UpdateTip}">
                    <TextBlock Classes="link" Text="Update"/>
                </Button>
                <Button x:Name="Open"
                        Classes="result"
                        AutomationProperties.Name="What's new"
                        Command="{Binding OpenCommand}"
                        ToolTip.Tip="The release on GitHub: what changed, and the download">
                    <TextBlock Classes="link" Text="What's new"/>
                </Button>
            </StackPanel>

            <!-- Downloading. -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDownloading}">
                <ProgressBar Width="90"
                             MinWidth="0"
                             Height="4"
                             MinHeight="4"
                             CornerRadius="2"
                             VerticalAlignment="Center"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Percent}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource Surface4Brush}"/>
                <TextBlock Text="{Binding PercentText}"/>
            </StackPanel>

            <!-- Installed. -->
            <Button x:Name="Restart"
                    Classes="result"
                    AutomationProperties.Name="Restart now"
                    IsVisible="{Binding IsReady}"
                    Command="{Binding RestartCommand}"
                    ToolTip.Tip="Close the app, install the new version and start it">
                <TextBlock Classes="link" Text="Restart now"/>
            </Button>

            <Button x:Name="Dismiss"
                    Classes="icon close"
                    AutomationProperties.Name="{Binding DismissTip}"
                    Content="✕"
                    Command="{Binding DismissCommand}"
                    ToolTip.Tip="{Binding DismissTip}"/>
        </StackPanel>
    </Border>
</UserControl>