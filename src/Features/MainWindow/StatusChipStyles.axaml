<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- What the status bar's flat chips share: a button that reads as text, and a dot for how things stand. -->

    <!-- The negative margin keeps the chip from making the bar taller, and lines its text up with the bar's padding. -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="-6,-3,0,-3"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    </Style>
    <Style Selector="Button.chip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
    </Style>
    <Style Selector="Button.chip:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}"/>
    </Style>
</Styles>
