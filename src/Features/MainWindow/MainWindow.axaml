<Window x:Name="RootWindow"
        x:Class="DeadlockAdvisor.Features.MainWindow.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mainWindow="using:DeadlockAdvisor.Features.MainWindow"
        xmlns:updates="using:DeadlockAdvisor.Features.MainWindow.Updates"
        xmlns:match="using:DeadlockAdvisor.Features.Match"
        xmlns:heroItems="using:DeadlockAdvisor.Features.HeroItems"
        xmlns:heroTraits="using:DeadlockAdvisor.Features.HeroTraits"
        xmlns:itemFormulas="using:DeadlockAdvisor.Features.ItemFormulas"
        xmlns:settings="using:DeadlockAdvisor.Features.Settings"
        xmlns:notifications="using:DeadlockAdvisor.Features.Shared.Notifications"
        xmlns:card="using:DeadlockAdvisor.Features.Shared.ItemCard"
        xmlns:enums="using:DeadlockAdvisor.Enums"
        x:DataType="mainWindow:MainWindowViewModel"
        Title="Deadlock Item Advisor"
        Icon="/src/Assets/app.ico"
        Width="1360"
        Height="880"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource BgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding ReloadCommand}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FindCommand}"/>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding QuitCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
        <!-- The Match page's own shortcuts: live whenever it's showing, wherever focus is. The
             rebindable ones (Random and Detect) are added from ShortcutBindings; Core/ShortcutKeys.cs
             keeps a fixed key here from being given to them too. -->
        <KeyBinding Gesture="Alt+D1" Command="{Binding SetModeCommand}" CommandParameter="{x:Static enums:Role.Self}"/>
        <KeyBinding Gesture="Alt+D2" Command="{Binding SetModeCommand}" CommandParameter="{x:Static enums:Role.Enemy}"/>
        <KeyBinding Gesture="Alt+D3" Command="{Binding SetModeCommand}" CommandParameter="{x:Static enums:Role.Ally}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Border#TitleBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <!-- Like any Windows title bar, an inactive window's chrome recedes. -->
        <Style Selector="Border#TitleBar TextBlock#WindowTitle">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
        </Style>
        <Style Selector="Border#TitleBar.inactive TextBlock#WindowTitle">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>
        <Style Selector="Border#TitleBar.inactive Menu > MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        </Style>

        <!-- the menu bar living in the title bar -->
        <Style Selector="Menu#MainMenu > MenuItem">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style Selector="Menu#MainMenu > MenuItem:pointerover /template/ Border#PART_LayoutRoot, Menu#MainMenu > MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
        </Style>
        <Style Selector="Menu#MainMenu > MenuItem:pointerover, Menu#MainMenu > MenuItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- minimise / maximise-restore / close, drawn Windows-style -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style Selector="Button.caption Path">
            <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
        <Style Selector="Border#TitleBar.inactive Button.caption Path">
            <Setter Property="Stroke" Value="{DynamicResource TextFaintBrush}"/>
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
        </Style>
        <Style Selector="Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ClosePressedBrush}"/>
        </Style>
        <Style Selector="Button.caption.close:pointerover Path, Button.caption.close:pressed Path">
            <Setter Property="Stroke" Value="White"/>
        </Style>
        <!-- The gear lights up while the Settings page is open, as a tab does for its page. -->
        <Style Selector="Button.caption.active Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Border#StatusBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="12,4,0,4"/>
        </Style>
        <Style Selector="Border#StatusBar TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The zoom stepper: flat buttons small enough not to make the bar taller. -->
        <Style Selector="Border#StatusBar Button.zoom">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border#StatusBar Button.zoom.level">
            <Setter Property="Width" Value="44"/>
        </Style>
        <Style Selector="Border#StatusBar Button.zoom Path">
            <Setter Property="Stroke" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="StrokeThickness" Value="1.25"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
        </Style>
        <Style Selector="Border#StatusBar Button.zoom:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
        </Style>
        <Style Selector="Border#StatusBar Button.zoom:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
        </Style>
        <Style Selector="Border#StatusBar Button.zoom:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Border#StatusBar Button.zoom:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <!-- At 100% there is nothing to reset, but the level still reads as text rather than as a dead button. -->
        <Style Selector="Border#StatusBar Button.zoom.level:disabled">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border#StatusBar TextBlock.saving">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border#StatusBar TextBlock.saving.failed">
            <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- A tooltip that opens under the pointer would take the hover from the control it describes. -->
        <Style Selector="ToolTip">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- The whole window zooms from here: every size is designed in DIPs at 100%. -->
        <LayoutTransformControl Margin="{Binding #RootWindow.OffScreenMargin}">
            <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
            </LayoutTransformControl.LayoutTransform>

            <DockPanel>
                <!-- Menus, page tabs, window title and caption buttons on one strip -->
                <Border x:Name="TitleBar" DockPanel.Dock="Top">
                    <Panel>
                        <!-- Centred on the whole window rather than the gap, so it sits where the eye expects;
                             hidden when the window is too narrow for it to clear the tabs. -->
                        <TextBlock x:Name="WindowTitle"
                                   Text="Deadlock Item Advisor"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <Grid x:Name="TitleBarGrid" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                            <Menu x:Name="MainMenu" Margin="6,0,0,0" VerticalAlignment="Center">
                                <MenuItem Header="_Data">
                                    <MenuItem Header="Check for Updates"
                                              Command="{Binding Updates.CheckAllCommand}"
                                              ToolTip.Tip="Look for a newer app, formulas and match data, and fetch the match data and art you don't have yet"/>
                                    <MenuItem Header="Downloads and Updates…"
                                              Command="{Binding OpenDataSettingsCommand}"
                                              ToolTip.Tip="What is installed and when it was checked, a button for each download, and how each is kept up to date"/>
                                    <!-- The tools for maintaining the model by hand only show with its editors. -->
                                    <MenuItem Header="Model Tools" IsVisible="{Binding ShowsEditors}">
                                        <MenuItem Header="Sync from Game API"
                                                  Command="{Binding DataMenu.SyncGameApiCommand}"
                                                  ToolTip.Tip="Pull item stats, costs, ids and new shop items from deadlock-api.com"/>
                                        <MenuItem Header="Sync New Heroes / Items / Categories"
                                                  Command="{Binding DataMenu.SyncNewDataCommand}"
                                                  ToolTip.Tip="Drop rows for ids that are gone after editing the CSVs by hand"/>
                                        <MenuItem Header="Model Health Report" Command="{Binding DataMenu.ModelHealthCommand}"/>
                                        <MenuItem Header="Reload from Disk"
                                                  InputGesture="Ctrl+R"
                                                  Command="{Binding ReloadCommand}"
                                                  ToolTip.Tip="Re-read the CSVs, discarding nothing (edits are already saved)"/>
                                        <MenuItem Header="Export Snapshot to Excel"
                                                  Command="{Binding DataMenu.ExportCommand}"
                                                  ToolTip.Tip="Write a read-only .xlsx copy of the CSVs for backup or review"/>
                                        <MenuItem Header="Open Data Folder" Command="{Binding DataMenu.OpenDataFolderCommand}"/>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Settings…" InputGesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
                                    <MenuItem Header="Quit" InputGesture="Ctrl+Q" Command="{Binding QuitCommand}"/>
                                </MenuItem>
                                <MenuItem Header="_View">
                                    <MenuItem Header="Zoom In" InputGesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}"/>
                                    <MenuItem Header="Zoom Out" InputGesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}"/>
                                    <MenuItem Header="Reset Zoom" InputGesture="Ctrl+D0" Command="{Binding ResetZoomCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Reload Art" Command="{Binding ReloadArtCommand}"/>
                                    <MenuItem Header="Find" InputGesture="Ctrl+F" Command="{Binding FindCommand}"/>
                                </MenuItem>
                                <MenuItem Header="_Help">
                                    <MenuItem Header="How Scoring Works" Command="{Binding HelpCommand}"/>
                                    <MenuItem Header="Recent Messages…" Command="{Binding RecentMessagesCommand}"
                                              ToolTip.Tip="The last messages that popped up, in case one went before you read it"/>
                                    <MenuItem Header="Third-Party Notices" Command="{Binding NoticesCommand}"
                                              ToolTip.Tip="The licenses of the software the app is built with"/>
                                </MenuItem>
                            </Menu>

                            <!-- The rule between the menus and the page tabs: they look alike, but one is
                                 commands and the other is where you are. -->
                            <Border Grid.Column="1"
                                    Width="21"
                                    Background="Transparent">
                                <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}"/>
                            </Border>

                            <!-- Clicking a tab doesn't pull focus out of the page: you usually switch
                                 pages to start typing into one. -->
                            <ListBox Grid.Column="2"
                                     x:Name="PageTabs"
                                     Classes="tabs"
                                     Focusable="False"
                                     VerticalAlignment="Center"
                                     ItemsSource="{Binding PageNames}"
                                     SelectedIndex="{Binding SelectedTab}"/>

                            <StackPanel x:Name="CaptionButtons" Grid.Column="4" Orientation="Horizontal">
                                <Button x:Name="SettingsButton"
                                        Classes="caption"
                                        Classes.active="{Binding IsSettingsOpen}"
                                        AutomationProperties.Name="Settings"
                                        ToolTip.Tip="Settings (Ctrl+,)"
                                        Command="{Binding OpenSettingsCommand}">
                                    <Path Data="M13.24,6.69 L15.21,6.86 L15.21,9.14 L13.24,9.31 A5.4,5.4 0 0 1 12.63,10.78 L13.91,12.29 L12.29,13.91 L10.78,12.63 A5.4,5.4 0 0 1 9.31,13.24 L9.14,15.21 L6.86,15.21 L6.69,13.24 A5.4,5.4 0 0 1 5.22,12.63 L3.71,13.91 L2.09,12.29 L3.37,10.78 A5.4,5.4 0 0 1 2.76,9.31 L0.79,9.14 L0.79,6.86 L2.76,6.69 A5.4,5.4 0 0 1 3.37,5.22 L2.09,3.71 L3.71,2.09 L5.22,3.37 A5.4,5.4 0 0 1 6.69,2.76 L6.86,0.79 L9.14,0.79 L9.31,2.76 A5.4,5.4 0 0 1 10.78,3.37 L12.29,2.09 L13.91,3.71 L12.63,5.22 A5.4,5.4 0 0 1 13.24,6.69 Z M10.4,8 A2.4,2.4 0 1 1 5.6,8 A2.4,2.4 0 1 1 10.4,8 Z"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          StrokeJoin="Round"/>
                                </Button>
                                <Button Classes="caption" AutomationProperties.Name="Minimize" ToolTip.Tip="Minimize" Click="MinimizeButton_Click">
                                    <Path Data="M0.5,5.5 L10.5,5.5" Width="11" Height="11"/>
                                </Button>
                                <Button Classes="caption" x:Name="MaximizeButton" AutomationProperties.Name="Maximize" ToolTip.Tip="Maximize" Click="MaximizeRestoreButton_Click">
                                    <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Width="11" Height="11"/>
                                </Button>
                                <Button Classes="caption close" AutomationProperties.Name="Close" ToolTip.Tip="Close" Click="CloseButton_Click">
                                    <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Width="11" Height="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Panel>
                </Border>

                <!-- Above the page, so the zoom corner can still be pressed where it's held larger than the bar. -->
                <Border x:Name="StatusBar" DockPanel.Dock="Bottom" ZIndex="1">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                        <updates:UpdatesView x:Name="Updates" VerticalAlignment="Center" DataContext="{Binding Updates}"/>
                        <mainWindow:ConnectionView x:Name="Connection"
                                                   Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   DataContext="{Binding Connection}"/>
                        <!-- Background downloads. The negative margins keep a chip from making the bar taller. -->
                        <ItemsControl x:Name="Jobs"
                                      Grid.Column="3"
                                      Margin="8,-3,0,-3"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding DataMenu.Jobs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Grid.Column="4"
                                   Classes="saving"
                                   Classes.failed="{Binding SaveFailed}"
                                   Margin="12,0,0,0"
                                   Text="{Binding SaveText}"
                                   IsVisible="{Binding SaveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <!-- The zoom buttons and the resize grip. ZoomCornerHold draws them from the window's corner,
                             at their old size while the pointer is on them. The negative margins stretch the
                             corner over the bar's padding, down to the window's edge, and the stepper's own
                             margins give back the height, so the bar is no taller than the stepper needs. -->
                        <Grid x:Name="ZoomCorner"
                              Grid.Column="5"
                              Margin="12,-4,0,-4"
                              ColumnDefinitions="Auto,Auto"
                              Background="Transparent">
                            <!-- Transparent so the wheel still lands here over a disabled button. -->
                            <StackPanel x:Name="ZoomStepper"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,4"
                                        Background="Transparent">
                                <Button Classes="zoom"
                                        AutomationProperties.Name="Zoom out"
                                        ToolTip.Tip="Zoom out (Ctrl+-)"
                                        ToolTip.Placement="Top"
                                        ToolTip.VerticalOffset="-6"
                                        Command="{Binding ZoomOutCommand}">
                                    <Path Data="M0,5 H10"/>
                                </Button>
                                <Button x:Name="ZoomLevel"
                                        Classes="zoom level"
                                        Content="{Binding ZoomText}"
                                        AutomationProperties.Name="{Binding ZoomText, StringFormat='Zoom {0}, reset to 100%'}"
                                        ToolTip.Tip="Zoom: click for 100% (Ctrl+0), scroll to change"
                                        ToolTip.Placement="Top"
                                        ToolTip.VerticalOffset="-6"
                                        Command="{Binding ResetZoomCommand}"/>
                                <Button Classes="zoom"
                                        AutomationProperties.Name="Zoom in"
                                        ToolTip.Tip="Zoom in (Ctrl+=)"
                                        ToolTip.Placement="Top"
                                        ToolTip.VerticalOffset="-6"
                                        Command="{Binding ZoomInCommand}">
                                    <Path Data="M0,5 H10 M5,0 V10"/>
                                </Button>
                            </StackPanel>
                            <!-- Gives the bottom-right corner something to see and grab. -->
                            <Border x:Name="ResizeGrip"
                                    Grid.Column="1"
                                    Width="22"
                                    Background="Transparent"
                                    Cursor="BottomRightCorner"
                                    ToolTip.Tip="Drag to resize">
                                <Path Data="M9,9 H11 V11 H9 Z M5,9 H7 V11 H5 Z M1,9 H3 V11 H1 Z M9,5 H11 V7 H9 Z M5,5 H7 V7 H5 Z M9,1 H11 V3 H9 Z"
                                      Width="12"
                                      Height="12"
                                      Margin="0,0,5,5"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Fill="{DynamicResource BorderStrongBrush}"
                                      IsHitTestVisible="False"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Panel>
                    <!-- Every page stays alive, so switching keeps its scroll position and state. -->
                    <Panel IsVisible="{Binding IsMatchPage}">
                        <match:MatchView x:Name="MatchPage" DataContext="{Binding Match}"/>
                    </Panel>
                    <Panel IsVisible="{Binding IsHeroItemsPage}">
                        <heroItems:HeroItemsView x:Name="HeroItemsPage" DataContext="{Binding HeroItems}"/>
                    </Panel>
                    <Panel IsVisible="{Binding IsHeroTraitsPage}">
                        <heroTraits:HeroTraitsView x:Name="HeroTraitsPage" DataContext="{Binding HeroTraits}"/>
                    </Panel>
                    <Panel IsVisible="{Binding IsItemFormulasPage}">
                        <itemFormulas:ItemFormulasView x:Name="ItemFormulasPage" DataContext="{Binding ItemFormulas}"/>
                    </Panel>
                    <Panel IsVisible="{Binding IsSettingsOpen}">
                        <settings:SettingsView x:Name="SettingsPage" DataContext="{Binding Settings}"/>
                    </Panel>
                    <notifications:NotificationOverlay DataContext="{Binding NotificationOverlay}"/>
                </Panel>
            </DockPanel>
        </LayoutTransformControl>

        <card:ItemCardPresenter x:Name="ItemCards" Zoom="{Binding UiScale}"/>

        <!-- The window's edge, for when it sits over something the same dark grey. -->
        <Border x:Name="WindowOutline"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"/>
    </Panel>
</Window>
