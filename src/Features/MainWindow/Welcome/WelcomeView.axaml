<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:welcome="using:DeadlockAdvisor.Features.MainWindow.Welcome"
             xmlns:download="using:DeadlockAdvisor.Features.MainWindow.MatchDownload"
             xmlns:settingsData="using:DeadlockAdvisor.Features.Settings.Data"
             xmlns:controls="using:DeadlockAdvisor.Controls"
             x:Class="DeadlockAdvisor.Features.MainWindow.Welcome.WelcomeView"
             x:DataType="welcome:WelcomeViewModel">
    <StackPanel Margin="20" Spacing="12" Width="460">
        <TextBlock Classes="h2" Text="{Binding Title}"/>
        <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding Intro}"/>

        <StackPanel Spacing="4">
            <CheckBox IsChecked="{Binding Art}">
                <TextBlock TextWrapping="Wrap" Text="{Binding ArtText}"/>
            </CheckBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <CheckBox IsChecked="{Binding MatchData}" IsEnabled="{Binding CanDownloadMatchData}">
                <StackPanel Spacing="2">
                    <TextBlock TextWrapping="Wrap" Text="Match results: how items do in real matches, a second opinion beside each recommendation"/>
                    <TextBlock Classes="faint" Text="{Binding MatchDataDetail}" IsVisible="{Binding CanDownloadMatchData}"/>
                </StackPanel>
            </CheckBox>
            <CheckBox Margin="28,0,0,0" IsChecked="{Binding Ranks}" IsEnabled="{Binding MatchData}" IsVisible="{Binding !IsShared}">
                <StackPanel Spacing="2">
                    <TextBlock TextWrapping="Wrap" Text="With the rank groups, to lean the numbers toward the ranks you play"/>
                    <TextBlock Classes="faint" Text="{Binding RanksDetail}" IsVisible="{Binding CanDownloadMatchData}"/>
                </StackPanel>
            </CheckBox>
            <TextBlock Classes="warning" TextWrapping="Wrap" Text="{Binding Offline}" IsVisible="{Binding !CanDownloadMatchData}"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock VerticalAlignment="Center" Text="Keep the match results and the advisor rating up to date"/>
                <controls:InfoBadge VerticalAlignment="Center" ToolTip.Tip="{x:Static download:MatchDownloadViewModel.AutoUpdateInfo}"/>
            </StackPanel>
            <ListBox Classes="segmented"
                     HorizontalAlignment="Left"
                     AutomationProperties.Name="How to keep up to date"
                     ItemsSource="{Binding Modes}"
                     SelectedItem="{Binding Mode}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="settingsData:UpdateModeOption">
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding Mode.Description}"/>
        </StackPanel>

        <TextBlock Classes="faint" TextWrapping="Wrap" Text="Data → Check for Updates brings the downloads any time, and Settings → Data changes how it keeps up to date."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
            <Button Classes="primary"
                    Content="Download"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    Command="{Binding StartCommand}"/>
            <Button Content="Not now"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Command="{Binding NotNowCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
