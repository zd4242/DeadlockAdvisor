<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:heroTraits="using:DeadlockAdvisor.Features.HeroTraits"
             xmlns:controls="using:DeadlockAdvisor.Controls"
             x:Class="DeadlockAdvisor.Features.HeroTraits.HeroTraitsView"
             x:DataType="heroTraits:HeroTraitsViewModel">

    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
                <TextBlock Classes="section" Text="HERO TRAITS" VerticalAlignment="Center"/>
                <controls:InfoBadge VerticalAlignment="Center" ToolTip.Tip="{x:Static heroTraits:HeroTraitsViewModel.Hint}"/>
            </StackPanel>
            <controls:SearchBox Grid.Column="1"
                                x:Name="SearchBox"
                                Width="200"
                                Watermark="Filter heroes..."
                                Text="{Binding FilterText}"/>
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="Copy from..."
                    Command="{Binding CopyFromCommand}"
                    ToolTip.Tip="Clone another hero's whole trait profile onto this one"/>
            <Button Grid.Column="3"
                    Classes="danger"
                    Margin="8,0,0,0"
                    Content="Clear hero"
                    Command="{Binding ClearHeroCommand}"
                    ToolTip.Tip="Reset every trait on the selected hero to 0"/>
            <TextBlock Grid.Column="5" Classes="faint" VerticalAlignment="Center" Text="{Binding ProgressText}"/>
        </Grid>

        <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0" Padding="12,8">
            <controls:RichText Classes="dim" MinHeight="36" TextWrapping="Wrap" Spans="{Binding ContextSpans}"/>
        </Border>

        <!-- Hugs the grid rather than stretching, so a wide window doesn't leave an empty band inside it. -->
        <Border HorizontalAlignment="Left"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto">
                <heroTraits:TraitGrid x:Name="Grid"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Heroes="{Binding Heroes}"
                                      Categories="{Binding Categories}"
                                      RowOrder="{Binding RowOrder}"
                                      VisibleRows="{Binding VisibleRows}"
                                      SortColumn="{Binding SortColumn}"
                                      SortDescending="{Binding SortDescending}"
                                      ValueOf="{Binding ValueOf}"
                                      CurrentRow="{Binding CurrentRow}"
                                      CurrentColumn="{Binding CurrentColumn}"
                                      PendingText="{Binding PendingText}"
                                      Revision="{Binding Revision}"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
