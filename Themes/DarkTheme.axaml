<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:DeadlockAdvisor.Theme">

    <!-- The palette lives in src/Theme/Palette.cs; these are its brushes. -->
    <SolidColorBrush x:Key="BgBrush" Color="{x:Static theme:Palette.Bg}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{x:Static theme:Palette.Surface}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{x:Static theme:Palette.Surface2}"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="{x:Static theme:Palette.Surface3}"/>
    <SolidColorBrush x:Key="Surface4Brush" Color="{x:Static theme:Palette.Surface4}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{x:Static theme:Palette.Border}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{x:Static theme:Palette.BorderStrong}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{x:Static theme:Palette.Text}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{x:Static theme:Palette.TextDim}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{x:Static theme:Palette.TextFaint}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static theme:Palette.Accent}"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="{x:Static theme:Palette.AccentDim}"/>
    <SolidColorBrush x:Key="AllyBrush" Color="{x:Static theme:Palette.Ally}"/>
    <SolidColorBrush x:Key="EnemyBrush" Color="{x:Static theme:Palette.Enemy}"/>
    <SolidColorBrush x:Key="SelfBrush" Color="{x:Static theme:Palette.Self}"/>
    <SolidColorBrush x:Key="PositiveBrush" Color="{x:Static theme:Palette.Positive}"/>
    <SolidColorBrush x:Key="NegativeBrush" Color="{x:Static theme:Palette.Negative}"/>
    <SolidColorBrush x:Key="FormulaBrush" Color="{x:Static theme:Palette.Formula}"/>
    <SolidColorBrush x:Key="DataBrush" Color="{x:Static theme:Palette.Data}"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{x:Static theme:Palette.CloseHover}"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="{x:Static theme:Palette.ClosePressed}"/>

    <!-- Fluent accent overrides, so stock controls pick up the gold -->
    <Color x:Key="SystemAccentColor">#e0a745</Color>
    <Color x:Key="SystemAccentColorLight1">#e6b460</Color>
    <Color x:Key="SystemAccentColorLight2">#ebc07a</Color>
    <Color x:Key="SystemAccentColorLight3">#f0cd95</Color>
    <Color x:Key="SystemAccentColorDark1">#c4903a</Color>
    <Color x:Key="SystemAccentColorDark2">#a87c31</Color>
    <Color x:Key="SystemAccentColorDark3">#8c6728</Color>

    <!-- Shared shell roles (modals, notifications) -->
    <SolidColorBrush x:Key="CardBackground" Color="{x:Static theme:Palette.Surface}"/>
    <SolidColorBrush x:Key="ModalBackground" Color="{x:Static theme:Palette.Surface2}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{x:Static theme:Palette.Tier2}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{x:Static theme:Palette.Ally}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{x:Static theme:Palette.Accent}"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="{x:Static theme:Palette.Accent}" Opacity="0.12"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{x:Static theme:Palette.Enemy}"/>

</ResourceDictionary>
