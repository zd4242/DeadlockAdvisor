<Project Sdk="Microsoft.NET.Sdk">

  <!-- The scheduled job behind the shared match data (.github/workflows/match-data.yml): the app's own download code, run headless. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DeadlockAdvisor.csproj" />
  </ItemGroup>

</Project>
