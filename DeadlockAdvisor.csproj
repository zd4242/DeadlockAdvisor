<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>src\Assets\app.ico</ApplicationIcon>
    <!-- A local build; the release workflow sets the version from its tag. -->
    <Version>0.0.0-dev</Version>
    <!-- Shown in the exe's properties, and required of a signed file by the code signing policy. -->
    <Product>Deadlock Item Advisor</Product>
    <Authors>Zach Davis</Authors>
    <Copyright>Copyright (c) 2026 Zach Davis</Copyright>
    <!-- The test and tool projects live beneath this one; keep their sources out of the app's default globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeadlockAdvisor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="src\Assets\**" Exclude="src\Assets\SeedData\**" />
    <!-- The starter data/, written to a fresh data folder on first run. -->
    <EmbeddedResource Include="src\Assets\SeedData\*" LogicalName="SeedData/%(Filename)%(Extension)" />
    <!-- The HTML5 named character references, for decoding the API's tooltip text. -->
    <EmbeddedResource Include="src\Services\GameApi\html5_entities.json" LogicalName="GameApi/html5_entities.json" />
    <!-- Reference digits for reading net worth off the top bar, cut from the labelled test captures. -->
    <EmbeddedResource Include="src\Vision\net_worth_glyphs.json" LogicalName="Vision/net_worth_glyphs.json" />
    <!-- The licenses of everything the app ships with, for Help → Third-Party Notices. -->
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ReactiveUI.Fody" Version="19.5.41" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />

    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.22" />
  </ItemGroup>
</Project>
