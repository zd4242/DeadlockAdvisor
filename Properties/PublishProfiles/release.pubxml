<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained executable, for Windows unless another runtime is given:
    dotnet publish -p:PublishProfile=release                 # publish\win-x64\DeadlockAdvisor.exe
    dotnet publish -p:PublishProfile=release -r linux-x64    # publish\linux-x64\DeadlockAdvisor
  The release workflow (.github/workflows/release.yml) builds every platform this way.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- ReactiveUI and binding reflection make trimming risky, and the saving isn't worth it. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>publish\$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>
</Project>
